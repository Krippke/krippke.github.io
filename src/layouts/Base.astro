---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Masthead from "../components/Masthead.astro";
import { otherLang, pathOf } from "../i18n/routes.ts";
import { ui } from "../i18n/ui.ts";
import { type Lang, SITE_URL } from "../lib/post-path.ts";

export interface Article {
  published: Date;
  updated: Date;
  tags: string[];
}

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path: string;
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  article?: Article;
  structuredData?: object;
  noindex?: boolean;
}

const SITE_TITLE = "Manuel Holzrichter";
const DEFAULT_IMAGE = "/assets/images/personal-website.jpg";

const { lang, title, description, path, alternates = {}, image, article, structuredData, noindex } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const metaDescription = description || t.siteDescription;
const canonical = `${SITE_URL}${path}`;
const ogImage = new URL(image ?? DEFAULT_IMAGE, SITE_URL).href;
const hreflangs = Object.entries({ ...alternates, [lang]: path }) as [Lang, string][];
const hasTranslation = alternates[otherLang(lang)] !== undefined;
const languageSwitchPath = alternates[otherLang(lang)] ?? pathOf("home", otherLang(lang));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch (error) {}
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (saved === "dark" || (!saved && prefersDark)) document.documentElement.classList.add("dark");
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      hreflangs.length > 1 &&
        hreflangs.map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={`${SITE_URL}${href}`} />)
    }
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={article.updated.toISOString()} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="alternate" type="application/atom+xml" href={pathOf("feed", lang)} title={`${SITE_TITLE} Feed`} />
    <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
    <link rel="manifest" href="/assets/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Masthead lang={lang} languageSwitchPath={languageSwitchPath} hasTranslation={hasTranslation} />
    <main id="main" class="page">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
