---
import { pathOf } from "../i18n/routes.ts";
import { ui } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { type Lang, SITE_URL } from "../lib/post-path.ts";
import { getPosts, translationOf } from "../lib/posts.ts";
import PostLog from "./PostLog.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const englishPostsForGermanReaders =
  lang === "de" ? (await getPosts("en")).filter((post) => !translationOf(post, posts)) : [];
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Manuel Holzrichter",
  url: SITE_URL,
  sameAs: ["https://github.com/Krippke"],
};
---

<Base lang={lang} path={pathOf("home", lang)} alternates={{ en: pathOf("home", "en"), de: pathOf("home", "de") }} structuredData={person}>
  <section class="intro">
    {
      lang === "en" ? (
        <>
          <h1 class="intro-statement">{t.authorIntro}</h1>
          <p class="intro-text measure">
            I write about software architecture, automated testing, and what makes developers truly effective, including how
            to work well with AI. Practical insights from real projects, not textbook theory.{" "}
            More <a href="/about">about me</a>, or what I can <a href="/services">do for your team</a>.
          </p>
        </>
      ) : (
        <>
          <h1 class="intro-statement">{t.authorIntro}</h1>
          <p class="intro-text measure">
            Ich schreibe über Softwarearchitektur, automatisierte Tests und darüber, was Entwickler wirklich effektiv macht,
            auch im Zusammenspiel mit KI. Praxis aus echten Projekten statt Lehrbuchtheorie.{" "}
            Mehr <a href="/de/ueber-mich">über mich</a>, oder was ich <a href="/de/leistungen">für Ihr Team tun</a> kann.
          </p>
        </>
      )
    }
  </section>

  {posts.length > 0 && <PostLog posts={posts} lang={lang} />}

  {
    englishPostsForGermanReaders.length > 0 && (
      <section class="other-language">
        <h2 class="other-language-title">{t.postsInOtherLanguage}</h2>
        <PostLog posts={englishPostsForGermanReaders} lang={lang} />
      </section>
    )
  }
</Base>

<style>
  .intro {
    padding-block: var(--space-l) var(--space-xl);
  }

  .intro-statement {
    max-width: 21em;
    margin: 0;
    font-size: var(--step-5);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.018em;
  }

  .intro-text {
    margin: var(--space-m) 0 0;
    color: var(--ink-soft);
    font-size: var(--step-1);
  }

  .other-language-title {
    margin: var(--space-l) 0 var(--space-m);
    font-size: var(--step-2);
  }
</style>
