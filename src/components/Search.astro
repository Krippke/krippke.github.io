---
import { ui } from "../i18n/ui.ts";
import type { Lang } from "../lib/post-path.ts";

interface Props {
  lang: Lang;
}

const t = ui[Astro.props.lang];
---

<button class="icon-button" type="button" data-search-open aria-label={t.searchLabel} title={t.search}>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
  </svg>
</button>

<dialog class="search-dialog" data-search-dialog aria-label={t.searchLabel}>
  <div class="search-panel">
    <div class="search-header">
      <h2>{t.search}</h2>
      <button class="icon-button" type="button" data-search-close aria-label={t.closeSearch}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <p class="search-error" data-search-error hidden>{t.searchUnavailable}</p>
    <div data-search-results></div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]")!;
  const errorMessage = dialog.querySelector<HTMLElement>("[data-search-error]")!;
  let searchLoaded = false;

  function load(element: HTMLLinkElement | HTMLScriptElement, url: string): Promise<void> {
    return new Promise((resolve, reject) => {
      element.onload = () => resolve();
      element.onerror = () => {
        element.remove();
        reject(new Error(`Could not load ${url}`));
      };
      document.head.append(element);
    });
  }

  function loadStylesheet(href: string): Promise<void> {
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = href;
    return load(link, href);
  }

  function loadScript(src: string): Promise<void> {
    const script = document.createElement("script");
    script.src = src;
    return load(script, src);
  }

  async function loadSearch() {
    if (searchLoaded) return;
    try {
      await Promise.all([loadStylesheet("/pagefind/pagefind-ui.css"), loadScript("/pagefind/pagefind-ui.js")]);
      const { PagefindUI } = window as unknown as { PagefindUI: new (options: object) => unknown };
      new PagefindUI({ element: "[data-search-results]", showSubResults: false, showImages: false, resetStyles: false });
      searchLoaded = true;
      errorMessage.hidden = true;
    } catch (error) {
      errorMessage.hidden = false;
      console.error(error);
    }
  }

  document.querySelector("[data-search-open]")?.addEventListener("click", async () => {
    dialog.showModal();
    await loadSearch();
    dialog.querySelector<HTMLInputElement>("input")?.focus();
  });

  document.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style is:global>
  .search-dialog {
    width: min(40rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(40rem, calc(100vh - 4rem));
    margin: 4rem auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
  }

  .search-dialog::backdrop {
    background: rgb(17 25 27 / 0.45);
  }

  .search-panel {
    padding: 1rem 1.25rem 1.5rem;
  }

  .search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .search-error {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
  }

  .search-header h2 {
    margin: 0;
    font-size: var(--step-1);
  }

  .search-dialog {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--accent-soft);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--serif);
  }
</style>
